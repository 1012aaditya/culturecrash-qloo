# ---------------------------------------------------------------------------
# CultureCrash environment. Copy to .env.local for development.
# Secrets are server-only: never prefix them with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Postgres connection used by the server (Supabase: Project Settings → Database →
# Connection string → Transaction pooler, port 6543). Required.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/culturecrash

# "supabase" (production) or "local" (development/tests against plain Postgres).
AUTH_MODE=supabase

# Supabase Auth (public values; required when AUTH_MODE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Private Storage bucket for uploaded brief documents
SUPABASE_STORAGE_BUCKET=brief-documents

# Required only when AUTH_MODE=local (32+ random characters). Refused on Vercel production.
SESSION_SECRET=

# Qloo Insights API (server-only). Hackathon keys use hackathon.api.qloo.com;
# production keys use https://api.qloo.com.
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com

# LLM provider (server-only). Without a key, CultureCrash uses a clearly labelled
# template engine for drafts instead of an LLM.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Optional alternates to Brave for web search (only one web-search provider is used per job).
TAVILY_API_KEY=
EXA_API_KEY=
YOUTUBE_API_KEY=

# Explicit demonstration mode: allows clearly labelled fixture research runs.
# Always disabled when VERCEL_ENV=production.
CC_DEMO_MODE=disabled

# Public base URL (auth email redirects, share links)
APP_BASE_URL=http://localhost:3000

# Email (optional) — Resend. Without these, no email is sent and the app says so.
RESEND_API_KEY=
EMAIL_FROM="CultureCrash <hello@your-verified-domain.com>"
# Where pilot requests from /pricing are forwarded
PILOT_NOTIFY_EMAIL=

# Scheduled jobs (retention cleanup, weekly digest). Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Multi-source research (see docs/RESEARCH_ENGINE.md). All optional; the app says which are missing.
# Web search: Brave is primary; Tavily or Exa are used only if Brave is not set.
# Serper (Google Search API) is the primary web search; Brave is used only if Serper is not set.
SERPER_API_KEY=
SERPER_USD_PER_REQUEST=0.001
BRAVE_API_KEY=
BRAVE_USD_PER_REQUEST=0.005
TAVILY_USD_PER_REQUEST=0.008
EXA_USD_PER_REQUEST=0.005
# YouTube Data API v3 (free quota). Stored excerpts expire after 30 days per YouTube's terms.
# Reddit Data API (OAuth app). Commercial use needs Reddit's approval: set REDDIT_COMMERCIAL_ACCESS=approved only once granted.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_COMMERCIAL_ACCESS=
# Cheaper model for planning and claim extraction; LLM_MODEL writes the synthesis.
LLM_MODEL_FAST=claude-haiku-5-5
# Qloo signal.demographics.age — leave unset until the accepted values are verified.
QLOO_AGE_SIGNAL=
# Google autocomplete phrasing (undocumented endpoint, NOT Google Trends). Off unless enabled.
GOOGLE_SUGGEST=
